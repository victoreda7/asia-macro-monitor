{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": {
    "deploymentEnabled": false
  },
  "ignoreCommand": "[ -n \"$VERCEL_GIT_COMMIT_SHA\" ] && exit 0 || exit 1",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/painel"
    },
    {
      "source": "/entrar",
      "destination": "/api/entrar"
    },
    {
      "source": "/sair",
      "destination": "/api/sair"
    },
    {
      "source": "/Cache/feed.json",
      "destination": "/api/feed"
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
